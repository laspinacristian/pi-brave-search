{
  "name": "pi-brave-search",
  "version": "1.1.2",
  "description": "Pi coding agent extension: a brave_search tool that returns the passages most relevant to a query (Brave LLM Context API), or recent news.",
  "type": "module",
  "license": "MIT",
  "author": "Cristian La Spina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laspinacristian/pi-brave-search.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "brave-search",
    "web-search"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.35",
    "typescript": "^7.0.2"
  }
}
